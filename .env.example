# Next.js proxies /api/* to this backend (server-side only).
BACKEND_URL=http://127.0.0.1:8090

# Browser calls same-origin /api/v1 — works with localhost:3000 or LAN IP:3000.
NEXT_PUBLIC_API_URL=/api/v1

# Meta Embedded Signup is loaded from backend /meta/embedded-config (no secrets in frontend).

# WebSocket (see resolve-ws-url.ts):
# - HTTPS: auto wss://<same-host>/ws (configure reverse proxy — deploy/nginx.example.conf)
# - HTTP dev (LAN IP): direct ws://<host>:8090/ws
# - HTTP via Next proxy: NEXT_PUBLIC_WS_SAME_ORIGIN=true
# - Full override: NEXT_PUBLIC_WS_URL=wss://app.example.com/ws
NEXT_PUBLIC_BACKEND_PORT=8090
