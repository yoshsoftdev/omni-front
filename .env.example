# Next.js proxies /api/* and /ws to backend (server-side only).
BACKEND_URL=http://127.0.0.1:8066

# Browser calls same-origin /api/v1
NEXT_PUBLIC_API_URL=/api/v1

# WebSocket (see resolve-ws-url.ts):
# - HTTPS: auto wss://<same-host>/ws (Next.js rewrites to backend)
# - HTTP dev (LAN IP): direct ws://<host>:8066/ws
# - Full override: NEXT_PUBLIC_WS_URL=wss://app.example.com/ws
NEXT_PUBLIC_BACKEND_PORT=8066
