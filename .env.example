# Next.js proxies /api/* to this backend (server-side only).
BACKEND_URL=http://127.0.0.1:8090

# Browser calls same-origin /api/v1 — works with localhost:3000 or LAN IP:3000.
NEXT_PUBLIC_API_URL=/api/v1

# WebSocket uses window.location.hostname + this port (override with NEXT_PUBLIC_WS_URL).
NEXT_PUBLIC_BACKEND_PORT=8090
