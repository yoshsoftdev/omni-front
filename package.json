{
  "name": "omni-chan-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --config vitest.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "pnpm build-storybook && docker run --rm --network host -u \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble node_modules/.bin/playwright test -c playwright.visual.config.ts --update-snapshots",
    "gen:api": "openapi-typescript ../docs/openapi/v1.yaml -o src/services/api/schema.gen.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-virtual": "^3.14.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.64.1",
    "@storybook/nextjs-vite": "10.6.5",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.12.1",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.5.28",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.31",
    "storybook": "10.6.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.31",
      "next>sharp": "0.35.5",
      "brace-expansion@1": "1.1.22",
      "brace-expansion@5": "5.0.13",
      "js-yaml@4": "4.3.2",
      "postcss-selector-parser@6": "6.1.6",
      "minimatch@10": "11.0.8"
    }
  }
}
